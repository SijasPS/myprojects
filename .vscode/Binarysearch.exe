#include <stdio.h>
int main()
{
    int arr[100],n,i,element,index=0;
    printf("Enter the size of array:");
    scanf("%d",&n);
    printf("Enter the array elements:\n",&n);
    for(i=0;i<n;i++)
    scanf("%d",&arr[1]);
int high=n-1,low=0,mid=(high+low)/2;
printf("Enter the element to be searched");
scanf("%d",&element);
{
    if (mid==element){
        index=1
        break;
    }
}
else if (mid<element)
        low=mid+1;
    else
    high=mid-1;
if (index=1)
printf("Element is found at position:%d",mid+1);
else
printf("Element not found");
return 0;
}